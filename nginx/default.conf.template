# Plantilla nginx per a la SPA de consulta del cens electoral.
# L'entrypoint de la imatge nginx hi substitueix ${BACKEND_URL}, ${BACKEND_TOKEN}
# i ${RATE_LIMIT} (vegeu NGINX_ENVSUBST_FILTER al Dockerfile). La resta de
# variables ($host, $binary_remote_addr...) queden intactes.

# IP real del client quan hi ha un balancejador/ingress al davant. Sense això,
# tots els ciutadans compartirien la IP del balancejador i el límit de
# peticions bloquejaria el servei sencer. REAL_IP_FROM és el rang de confiança.
set_real_ip_from ${REAL_IP_FROM};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=consulta:10m rate=${RATE_LIMIT};

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # API del cens: només POST, cos màxim 4 KB, amb límit de peticions.
    # El token viatja només entre nginx i el backend: mai arriba al navegador.
    location = /api/consulta {
        limit_except POST { deny all; }

        limit_req zone=consulta burst=${RATE_BURST} nodelay;
        limit_req_status 429;

        client_max_body_size 4k;

        proxy_pass ${BACKEND_URL}/consulta;
        proxy_http_version 1.1;
        proxy_set_header Authorization "${BACKEND_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    # La resta de /api/* no existeix.
    location /api/ {
        return 404;
    }

    # Configuració en temps d'execució: mai en cache (es pot muntar com a volum).
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Assets amb hash del build de Vite: cache llarga i immutable.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA i index.html: sense cache.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ /index.html;
    }
}
